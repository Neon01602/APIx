{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "api/apix_pilot_fares.csv" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
